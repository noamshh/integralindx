# Environment Variables for IntegralIndx Deployment
# Copy this file to .env and fill in the values

# Embedder Configuration
# Options: tfidf, sentence_bert, ii-cl-19m_v1.0, or your custom embedder name
INTEGRALINDX_EMBEDDER=ii-cl-19m_v1.0

# Development Mode
# Set to 'true' to enable curation features (remove instances)
# Set to 'false' for production
INTEGRALINDX_DEV_MODE=false

# Server Configuration
PORT=8080

# Health Check Authentication (for Fly.io deployment)
# Secret token for /health endpoint - prevents public access
# IMPORTANT: Set this in Fly.io via: flyctl secrets set HEALTH_TOKEN=your-random-secret
# Also update fly.toml [http_service.checks.headers] to match this value
HEALTH_TOKEN=change-this-to-a-random-secret

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# PLAUSIBLE_DOMAIN=integralindx.fly.dev

# Optional: Custom domain
# CUSTOM_DOMAIN=integralindx.yourdomain.com

# Optional: Logging level
# LOG_LEVEL=INFO
