# Environment Variables for IntegralIndx Deployment
# Copy this file to .env and fill in the values

# Embedder Configuration
# Options: tfidf, sentence_bert, ii-cl-19m_prod, or your custom embedder name
INTEGRALINDX_EMBEDDER=ii-cl-19m_prod

# Development Mode
# Set to 'true' to enable curation features (remove instances)
# Set to 'false' for production
INTEGRALINDX_DEV_MODE=false

# Server Configuration
PORT=8080

# Health Check Authentication
# Secret token for /health endpoint - prevents public access
HEALTH_TOKEN=change-this-to-a-random-secret

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
